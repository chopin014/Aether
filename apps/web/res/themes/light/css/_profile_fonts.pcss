/*
 * Fonts a person can choose for their display name, all under the SIL Open Font License (licences beside the files
 * in res/fonts/ProfileNames). Each has an Aether-only family name, so a copy installed on the viewer's computer can
 * never change how someone's name looks, and is downloaded only when a name on screen uses it. One weight and the
 * Latin range each: names in other scripts fall back to the app's own font.
 */

@font-face {
    font-family: "Aether Name Pixel";
    font-style: normal;
    font-weight: 600;
    font-display: swap;
    src: url("/res/fonts/ProfileNames/pixelify-sans-latin-600.woff2") format("woff2");
}

@font-face {
    font-family: "Aether Name Medieval";
    font-style: normal;
    font-weight: 400;
    font-display: swap;
    src: url("/res/fonts/ProfileNames/pirata-one-latin-400.woff2") format("woff2");
}

