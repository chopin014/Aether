.mx_MemberListView {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;

    .mx_MemberListView_container {
        height: 100%;
    }

    .mx_MemberListView_separator {
        margin: 0;
        border: none;
        border-top: 2px solid var(--cpd-color-bg-subtle-primary);
    }

    /* Desktop-only headings share the virtualized member row's fixed height. */
    .mx_MemberListView_groupHeading {
        box-sizing: border-box;
        height: var(--cpd-space-12x);
        margin: 0;
        padding: var(--cpd-space-5x) var(--cpd-space-2x) var(--cpd-space-1x);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font: var(--cpd-font-body-xs-semibold);
        color: var(--cpd-color-text-secondary);
        text-transform: uppercase;
    }
}
