.mx_PinnedMessagesPopover {
    position: fixed;
    inset: auto;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    color: var(--cpd-color-text-primary);
    text-align: start;
    -webkit-app-region: no-drag;

    &::backdrop {
        background: transparent;
        pointer-events: none;
    }
}

.mx_PinnedMessagesPopover_active svg {
    fill: var(--cpd-color-icon-accent-primary);
}
