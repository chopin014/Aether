.mx_DesktopProfilePopout {
    display: flex;
    max-width: calc(100vw - var(--cpd-space-4x));
    -webkit-app-region: no-drag;
}

/* The view draws its own surface, close button and padding, so the modal frame is made transparent. */
.mx_Dialog_desktopProfile .mx_Dialog {
    padding: 0;
    background: transparent;
    overflow: visible;
    box-shadow: none;
    -webkit-app-region: no-drag;
}

.mx_DesktopFullProfileDialog {
    padding: 0;
    background: transparent;
    overflow: visible;

    .mx_Dialog_cancelButton {
        display: none;
    }
}
