/* Theme aliases inherit into portal roots, including settings and verification dialogs. */
body.mx_DesktopShell {
    --aether-call-background: var(--cpd-color-bg-canvas-default);
    /* Aether colour primitives from the identity package (tokens/aether-tokens.css). Use the semantic roles. */
    --ae-vacuo: #090a12;
    --ae-orbita: #12142a;
    --ae-orbita-alta: #1c1f38;
    --ae-poeira: #2a2d4a;
    --ae-lunar: #9a9cc0;
    --ae-lunar-700: #4c5070;
    --ae-gelo: #eceaf6;
    --ae-branco: #ffffff;
    --ae-nevoa: #f6f5fb;
    --ae-nevoa-300: #dadce6;
    --ae-polar: #8ed8ea;
    --ae-polar-800: #1f6577;
    --mx-desktop-shell-header-height: 49px;
    /*
     * The native window controls cover the top right corner of the page. Anything that reaches that corner moves
     * left by the inline size, or down by the block size. Both are 0 where there are no controls.
     */
    --mx-window-controls-inline-size: calc(100vw - env(titlebar-area-x, 0px) - env(titlebar-area-width, 100vw));
    --mx-window-controls-block-size: env(titlebar-area-height, 0px);
    --mx-desktop-shell-frame: var(--cpd-color-bg-subtle-secondary);
    --mx-desktop-header-border: 1px solid var(--cpd-color-border-interactive-secondary);
    --mx-desktop-header-padding: 14px;
    --mx-desktop-sidebar-heading-size: 16px;
    --mx-desktop-search-border: var(--mx-desktop-header-border);
    /* With the sidebar's top border, the padding centres a 32px button on the same line as the room header's. */
    --mx-desktop-search-padding: 7px 10px 8px;
    --mx-desktop-search-button-padding: 0 8px;
    --mx-desktop-search-button-size: 32px;
    --mx-desktop-search-background: var(--cpd-color-bg-subtle-primary);
    /*
     * Direct messages carry a profile avatar; channels a 24px symbol on a 32px row. Each row has 1px above and below,
     * so neighbouring rows sit 2px apart and a list reads as one block.
     */
    --mx-desktop-room-content-height: 42px;
    --mx-desktop-channel-content-height: 32px;
    --mx-desktop-channel-row-gap: 1px;
    /*
     * A category keeps clear of the list above it and sits close to its own channels, so each heading reads as
     * belonging to what follows it rather than floating between two lists.
     */
    --mx-desktop-category-padding: 16px 0 2px;
    --mx-desktop-category-inner-padding: 2px 8px 2px 4px;
    --mx-desktop-room-margin: 8px;
    --mx-desktop-room-radius: 6px;
    --mx-desktop-room-marker: transparent;
    /* The dock's account row, which the message composer matches. */
    --mx-desktop-dock-row-height: 60px;
    /* The account dock floats 8px above the bottom; its height is measured by DesktopAccountDockContainer. */
    --mx-desktop-dock-clearance: calc(var(--mx-desktop-dock-height, 56px) + 16px);

    /* Compound's search field must not inherit the legacy text-input border and margin. */
    .mx_MatrixChat_wrapper
        [data-desktop-contacts]
        label:not(.mx_textinput):not(.mx_Field):not(.mx_no_textinput)
        > input[type="search"] {
        border: 0;
        margin: 0;
        background: transparent;
    }

    /* The portalled sound picker owns its search field; exclude the legacy input padding and weight. */
    [data-soundboard] label input[type="search"] {
        padding: 0;
        font: var(--cpd-font-body-md-regular);
        margin: 0;
        border: 0;
        background: transparent;
    }

    /*
     * Dialogs drop Compound's glass frame. Its translucent band and outline kept their own corners: a square rim
     * around the rounded profile card, which draws its own surface, and light wedges in the corners of dialogs whose
     * inner rounding differed. A dialog is one surface here, its corners following the frame's.
     */
    .mx_Dialog_wrapper:not(.mx_Dialog_lightbox, .mx_Dialog_spinner) .mx_Dialog_border {
        padding: 0;
        outline: none;
        background: none;
        backdrop-filter: none;
        border-radius: 12px;

        > .mx_Dialog {
            border-radius: inherit;
        }
    }

    /* Without the glass, a dialog keeps a hairline edge and lifts off the page with a soft shadow. */
    .mx_Dialog_wrapper:not(.mx_Dialog_lightbox, .mx_Dialog_spinner, .mx_Dialog_desktopProfile)
        .mx_Dialog_border
        > .mx_Dialog {
        box-shadow:
            0 0 0 1px var(--cpd-color-border-interactive-secondary),
            0 16px 40px rgb(0 0 0 / 40%);
    }

    /* Keep the desktop frame visible around the captured settings modal. */
    .mx_Dialog_border:has(.mx_UserSettingsDialog, .mx_RoomSettingsDialog, .mx_SpaceSettingsDialog) {
        width: calc(100% - 80px);
        max-width: 1440px;
        height: calc(100% - 80px);
        max-height: calc(100% - 2 * max(40px, var(--mx-window-controls-block-size)));
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        border-radius: 12px;
        padding: 0;
        overflow: hidden;
    }

    .mx_Dialog:has(.mx_UserSettingsDialog, .mx_RoomSettingsDialog, .mx_SpaceSettingsDialog) {
        height: 100%;
        padding: 0;
        overflow: hidden;
        background: var(--cpd-color-bg-subtle-primary);
    }

    .mx_UserSettingsDialog,
    .mx_RoomSettingsDialog,
    .mx_SpaceSettingsDialog {
        --mx-desktop-settings-sidebar: 252px;
        width: 100%;
        max-width: none;
        height: 100%;
        padding: 0;
        overflow: hidden;

        &::before {
            content: "";
            position: absolute;
            inset: 0 auto 0 0;
            width: var(--mx-desktop-settings-sidebar);
            background: var(--cpd-color-bg-canvas-default);
        }

        .mx_Dialog_header {
            height: 49px;
            margin: 0;
            padding: 0 48px 0 calc(var(--mx-desktop-settings-sidebar) + 16px);
            display: flex;
            align-items: center;
            border-block-end: 1px solid var(--cpd-color-border-interactive-secondary);
        }

        .mx_Dialog_title,
        .mx_UserSettingsDialog_title,
        .mx_UserSettingsDialog_title_strong {
            margin: 0;
            font: var(--cpd-font-body-lg-semibold) !important;
        }

        .mx_Dialog_cancelButton {
            top: 12px;
            right: 12px;
            background: transparent;
        }

        .mx_TabbedView_tabsOnLeft {
            inset: 49px 0 0;
            margin: 0;
            padding: 0;

            .mx_TabbedView_tabLabels {
                position: absolute;
                inset: 16px auto 16px 16px;
                width: calc(var(--mx-desktop-settings-sidebar) - 32px);
                max-width: none;
                overflow-y: auto;
            }

            .mx_TabbedView_tabLabel {
                border-radius: 6px;
                justify-content: flex-start;
                padding: 6px 8px;
                min-height: 36px;

                svg {
                    margin-inline-end: 8px;
                }
            }

            .mx_TabbedView_tabLabel_text {
                display: inline;
            }

            .mx_TabbedView_tabPanel {
                margin: 0 0 0 var(--mx-desktop-settings-sidebar);
                min-width: 0;
                height: 100%;
            }

            .mx_TabbedView_tabPanelContent {
                padding: 24px clamp(24px, 6vw, 124px);
                box-sizing: border-box;
            }
        }

        .mx_TabbedView .mx_SettingsTab {
            min-width: 0;
            padding: 0 0 64px;
        }

        .mx_SettingsTab_heading {
            font: var(--cpd-font-heading-md-semibold);
        }
    }

    .mx_RoomSettingsDialog_desktop {
        --mx-desktop-settings-sidebar: clamp(260px, 28vw, 360px);
        position: relative;

        &::before {
            display: none;
        }

        .mx_Dialog_header {
            padding-inline-start: calc(var(--mx-desktop-settings-sidebar) + 24px);
        }

        .mx_Dialog_title {
            font: var(--cpd-font-heading-sm-semibold) !important;
        }

        .mx_Dialog_cancelButton {
            z-index: 2;
            border-radius: 50%;
            outline: 1px solid var(--cpd-color-border-interactive-secondary);
        }
    }

    .mx_RoomSettingsDialog_desktopIdentity {
        position: absolute;
        z-index: 1;
        inset: 0 auto auto 24px;
        width: calc(var(--mx-desktop-settings-sidebar) - 48px);
        height: 49px;
        display: flex;
        align-items: center;
        gap: 8px;
        overflow: hidden;
        color: var(--cpd-color-text-primary);
        font: var(--cpd-font-body-md-semibold);
        pointer-events: none;
    }

    .mx_RoomSettingsDialog_desktopIdentity_icon {
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-heading-sm-semibold);
    }

    .mx_RoomSettingsDialog_desktopIdentity_name {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_RoomSettingsDialog_desktopIdentity_type {
        margin-inline-start: auto;
        padding-inline-start: 8px;
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-xs-medium);
        white-space: nowrap;
    }

    @media (max-width: 760px) {
        .mx_Dialog_border:has(.mx_RoomSettingsDialog_desktop) {
            width: calc(100% - 32px);
            height: calc(100% - 32px);
            max-height: calc(100% - 2 * max(16px, var(--mx-window-controls-block-size)));
        }

        .mx_RoomSettingsDialog_desktop {
            --mx-desktop-settings-sidebar: 216px;

            .mx_Dialog_header {
                padding-inline-start: calc(var(--mx-desktop-settings-sidebar) + 16px);
            }
        }

        .mx_RoomSettingsDialog_desktopIdentity {
            inset-inline-start: 16px;
            width: calc(var(--mx-desktop-settings-sidebar) - 32px);
        }
    }

    @media (max-width: 520px) {
        .mx_RoomSettingsDialog_desktop {
            --mx-desktop-settings-sidebar: 164px;
        }

        .mx_RoomSettingsDialog_desktopIdentity_type {
            display: none;
        }
    }
}

/* Semantic roles from aether-tokens.css. High-contrast themes keep Compound colours. */
body.mx_DesktopShell.cpd-theme-dark {
    --ae-bg: var(--ae-vacuo);
    --ae-surface: var(--ae-orbita);
    --ae-surface-raised: var(--ae-orbita-alta);
    --ae-border: var(--ae-poeira);
    --ae-text: var(--ae-gelo);
    --ae-text-muted: var(--ae-lunar);
    --ae-accent: var(--ae-polar);
    --ae-on-accent: var(--ae-vacuo);
    --ae-focus: var(--ae-polar);
    /* Not in the manual: Polar shaded towards Vácuo, keeping Vácuo text above 7:1. */
    --ae-accent-hovered: #7ab9ca;
    --ae-accent-pressed: #6da5b4;
    /* The darker surface frames the content area. */
    --mx-desktop-shell-frame: var(--ae-bg);
    --cpd-color-bg-canvas-default: var(--ae-surface);
    --cpd-color-bg-subtle-secondary: var(--ae-bg);
}

body.mx_DesktopShell.cpd-theme-light {
    --ae-bg: var(--ae-branco);
    --ae-surface: var(--ae-nevoa);
    --ae-surface-raised: var(--ae-gelo);
    --ae-border: var(--ae-nevoa-300);
    --ae-text: var(--ae-vacuo);
    --ae-text-muted: var(--ae-lunar-700);
    --ae-accent: var(--ae-polar-800);
    --ae-on-accent: var(--ae-branco);
    --ae-focus: var(--ae-polar-800);
    /* Not in the manual: Polar 800 shaded towards Vácuo, raising white text contrast. */
    --ae-accent-hovered: #1c5768;
    --ae-accent-pressed: #1a4e5e;
    --mx-desktop-shell-frame: var(--ae-surface);
    --cpd-color-bg-canvas-default: var(--ae-bg);
    --cpd-color-bg-subtle-secondary: var(--ae-surface);
}

body.mx_DesktopShell:is(.cpd-theme-dark, .cpd-theme-light) {
    --cpd-color-bg-subtle-primary: var(--ae-surface-raised);
    /*
     * Compound's neutral action defaults use theme-bg, bypassing our canvas aliases. Let them sit on any
     * Aether surface (including portal menus and the profile frame), with overlays for hover and press.
     * Keep Compound's 4%/6% secondary-action feedback strengths.
     */
    --cpd-color-bg-action-secondary-rest: transparent;
    --cpd-color-bg-action-secondary-hovered: color-mix(in srgb, var(--ae-text) 4%, transparent);
    --cpd-color-bg-action-secondary-pressed: color-mix(in srgb, var(--ae-text) 6%, transparent);
    --cpd-color-bg-action-tertiary-rest: transparent;
    --cpd-color-bg-action-tertiary-hovered: var(--ae-surface-raised);
    --cpd-color-bg-action-tertiary-selected: var(--ae-border);
    --cpd-color-text-primary: var(--ae-text);
    --cpd-color-text-secondary: var(--ae-text-muted);
    --cpd-color-text-tertiary: var(--ae-text-muted);
    --cpd-color-icon-primary: var(--ae-text-muted);
    --cpd-color-icon-secondary: var(--ae-text-muted);
    --cpd-color-border-interactive-secondary: var(--ae-border);
    --cpd-color-border-focused: var(--ae-focus);
    --cpd-color-bg-accent-rest: var(--ae-accent);
    --cpd-color-bg-accent-hovered: var(--ae-accent-hovered);
    --cpd-color-bg-accent-pressed: var(--ae-accent-pressed);
    --cpd-color-bg-action-primary-rest: var(--ae-accent);
    --cpd-color-bg-action-primary-hovered: var(--ae-accent-hovered);
    --cpd-color-bg-action-primary-pressed: var(--ae-accent-pressed);
    --cpd-color-text-on-solid-primary: var(--ae-on-accent);
    --cpd-color-icon-on-solid-primary: var(--ae-on-accent);
    --cpd-color-icon-accent-tertiary: var(--ae-accent);
    /* A theme's accent can be too dark to read as text or an icon, even when it works as a fill. */
    --cpd-color-text-action-accent: var(--ae-accent-foreground, var(--ae-accent));
    --cpd-color-icon-accent-primary: var(--ae-accent-foreground, var(--ae-accent));
    --cpd-color-text-link-external: var(--ae-accent-foreground, var(--ae-accent));
    /*
     * Older styles use Compound's gray scale directly for icons and waveforms. It suits Compound's own near-black and
     * white, and nearly disappears on any other surface, so these steps follow the theme's colours instead.
     */
    --cpd-color-gray-800: var(--ae-text-muted);
    --cpd-color-gray-600: color-mix(in srgb, var(--ae-text-muted) 85%, var(--ae-surface-raised));
}

/*
 * A tooltip has a neutral fill, where the text colour meant for accent fills may be unreadable. Compound only gives
 * tooltips the role when they describe their button, not when they name it, so this matches its class.
 */
body.mx_DesktopShell:is(.cpd-theme-dark, .cpd-theme-light) [class*="_tooltip_"] {
    --cpd-color-text-on-solid-primary: var(--cpd-color-bg-canvas-default);
}

/*
 * A server's hover card, while people are in its voice channels, is a raised card like Discord's instead of a plain
 * label. The card shows the server's name itself, beside its icon, so the label stays only for screen readers.
 * Compound forces its caption into its own dark theme, so the colours come from the shell's palette, falling back
 * to Compound's for the high-contrast themes that keep it.
 */
body.mx_DesktopShell [class*="_tooltip_"]:has([data-server-hover-card]) {
    --server-hover-card-background: var(--ae-surface-raised, var(--cpd-color-bg-canvas-default));
    --server-hover-card-text: var(--ae-text, var(--cpd-color-text-primary));

    align-items: stretch;
    min-width: 200px;
    max-width: 280px;
    padding: var(--cpd-space-3x);
    border: var(--cpd-border-width-1) solid var(--ae-border, var(--cpd-color-border-interactive-secondary));
    border-radius: 8px;
    background: var(--server-hover-card-background);
    color: var(--server-hover-card-text);
    box-shadow: 0 8px 16px rgb(0 0 0 / 24%);
    text-align: start;

    > span:first-of-type {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    [class*="_caption_"] {
        color: var(--server-hover-card-text);
    }

    [class*="_arrow_"] {
        fill: var(--server-hover-card-background);
    }
}

.mx_MatrixChat_wrapper.mx_MatrixChat_desktopShell {
    background: var(--mx-desktop-shell-frame);
    flex-direction: column;

    .mx_MatrixChat {
        > [data-group] {
            position: relative;
        }

        min-height: 0;
        height: auto;
    }

    /*
     * On Linux and Windows the system title bar is replaced by window controls drawn over the top right
     * (titleBarOverlay in the desktop app). The env() values exist only then, so elsewhere these rules add nothing.
     * The header row is the window's drag handle; anything clickable inside it opts out.
     */
    :is(.mx_RoomHeader, [data-testid="room-list-header"], [data-desktop-contacts] > header) {
        -webkit-app-region: drag;

        :is(button:not(.mx_RoomHeader_infoWrapper), a, input, select, [role="button"], [role="menuitem"]) {
            -webkit-app-region: no-drag;
        }
    }

    /* The channel name opens its menu, while the empty space after it moves the window. */
    .mx_RoomHeader_infoWrapper {
        -webkit-app-region: drag;

        :is(.mx_RoomHeader_heading, .mx_DesktopShell_channelTopic) {
            -webkit-app-region: no-drag;
        }
    }

    /* Whatever reaches the top right corner keeps clear of the window controls. */
    .mx_RoomView > .mx_RoomHeader,
    .mx_RoomView:not(:has(.mx_RightPanel)) .mx_RoomHeader {
        padding-inline-end: calc(var(--cpd-space-3x) + var(--mx-window-controls-inline-size));
    }

    [data-desktop-contacts] > header {
        padding-inline-end: calc(var(--cpd-space-4x) + var(--mx-window-controls-inline-size));
    }

    /* The resizable panel's inner flex item must shrink to zero when collapsed. */
    .mx_LeftPanel_panel {
        min-width: 0;
    }

    /* Compound's image has its own size; keep it inside the resized desktop avatar frame. */
    .mx_SpacePanel .mx_SpaceButton_narrow .mx_BaseAvatar > img,
    .mx_RoomHeader .mx_BaseAvatar > img {
        display: block;
        width: 100%;
        height: 100%;
        border-radius: inherit;
    }

    /*
     * The server rail, after Discord's: 48px icons in a 72px rail, circles that round into squares when hovered or
     * selected, and a pill at the rail's edge for unread (8px), hover (20px) and selected (40px).
     */
    .mx_SpacePanel {
        --mx-desktop-rail-icon: 48px;
        --mx-desktop-rail-inset: 12px;

        background: var(--mx-desktop-rail-background, var(--mx-desktop-shell-frame));
        border-inline-end: none;
        padding-block-start: var(--cpd-space-2x);
        padding-block-end: var(--mx-desktop-dock-clearance);

        &.collapsed {
            width: calc(var(--mx-desktop-rail-icon) + 2 * var(--mx-desktop-rail-inset));
        }

        /* Discord's divider between Home and the servers. */
        .mx_SpaceItem_meta:not(:has(~ .mx_SpaceItem_meta))::after {
            content: "";
            display: block;
            width: 32px;
            height: 2px;
            /* Centre under the icons; the meta item is narrower than the rail. */
            margin-block: 4px;
            margin-inline-start: calc(var(--mx-desktop-rail-inset) + (var(--mx-desktop-rail-icon) - 32px) / 2);
            border-radius: 1px;
            background: var(--cpd-color-border-interactive-secondary);
        }

        /* Element's tree gutter and trailing padding would shift the icons off the rail's centre line. */
        .mx_SpaceButton_narrow,
        .mx_SpaceItem:not(.hasSubSpaces) > .mx_SpaceButton_narrow {
            margin-inline-start: var(--mx-desktop-rail-inset);
            padding-block: 4px;
            padding-inline: 0;
            min-width: var(--mx-desktop-rail-icon);

            .mx_SpaceButton_selectionWrapper {
                flex: none;
                width: var(--mx-desktop-rail-icon);
                padding: 0;
                border: 0;
                border-radius: 50%;
                transition: border-radius 150ms ease-out;

                &::before {
                    content: "";
                    position: absolute;
                    inset-inline-start: calc(-1 * var(--mx-desktop-rail-inset));
                    width: 4px;
                    height: 0;
                    border-radius: 0 4px 4px 0;
                    background: var(--cpd-color-text-primary);
                    transition: height 150ms ease-out;
                }
            }

            &:not(:hover, :focus-visible):has(.mx_SpacePanel_badgeContainer [data-badge-type])
                .mx_SpaceButton_selectionWrapper::before {
                height: 8px;
            }

            &:is(:hover, :focus-visible) .mx_SpaceButton_selectionWrapper {
                border-radius: 16px;

                &::before {
                    height: 20px;
                }
            }

            &.mx_SpaceButton_active .mx_SpaceButton_selectionWrapper {
                border: 0;
                padding: 0;
                border-radius: 16px;
                background: var(--cpd-color-bg-accent-rest);

                &::before {
                    height: 40px;
                }
            }

            /* Icons on the accent fill take the on-accent colour. */
            &.mx_SpaceButton_active .mx_SpaceButton_icon svg {
                color: var(--cpd-color-icon-on-solid-primary);
            }

            .mx_SpaceButton_icon {
                width: 28px;
                height: 28px;
                padding: 10px;
                border-radius: inherit;
                background-color: var(--mx-desktop-rail-icon-background, var(--cpd-color-bg-subtle-primary));
                transition: background-color 150ms ease-out;
            }

            &.mx_SpaceButton_active .mx_SpaceButton_icon {
                background-color: transparent;
            }

            /* The Aether mark is twice as wide as it is tall, so it may use the icon's padding to read clearly. */
            .mx_SpaceButton_icon svg.mx_DesktopShell_homeSymbol {
                width: 36px;
                margin-inline: -4px;
                color: var(--cpd-color-text-primary);
            }

            &.mx_SpaceButton_active .mx_SpaceButton_icon svg.mx_DesktopShell_homeSymbol {
                color: var(--cpd-color-icon-on-solid-primary);
            }

            .mx_BaseAvatar {
                --cpd-avatar-size: var(--mx-desktop-rail-icon);

                /* The room's inline avatar size can be smaller than the rail tile. */
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: var(--mx-desktop-rail-icon);
                height: var(--mx-desktop-rail-icon);
                border-radius: inherit;
            }

            .mx_SpaceButton_avatarWrapper,
            .mx_SpaceButton_avatarPlaceholder {
                border-radius: inherit;
            }

            /* The pill marks unread servers, so only counts and mentions keep a badge, at the bottom right. */
            .mx_SpacePanel_badgeContainer {
                inset: auto -4px -4px auto;

                [data-badge-type="dot"] {
                    display: none;
                }
            }
        }

        /* Rail actions use accent icons that fill on hover, as in Discord. */
        .mx_SpaceButton_new.mx_SpaceButton_narrow,
        .mx_SpaceButton_discover.mx_SpaceButton_narrow {
            .mx_SpaceButton_icon svg {
                color: var(--cpd-color-icon-accent-primary);
            }

            &:is(:hover, :focus-visible) .mx_SpaceButton_icon {
                background-color: var(--cpd-color-bg-accent-rest);

                svg {
                    color: var(--cpd-color-icon-on-solid-primary);
                }
            }

            /* The pill only marks servers. */
            .mx_SpaceButton_selectionWrapper::before {
                display: none;
            }
        }
    }

    /* The sidebar's rounded corner sits on the rail, so the rail's colour has to show behind it. */
    .mx_LeftPanel_outerWrapper {
        background: var(--mx-desktop-rail-background, var(--mx-desktop-shell-frame));
    }

    .mx_LeftPanel {
        /* The top border takes one pixel, so the header's line still meets the room header's. */
        --mx-desktop-shell-header-height: 48px;
        --mx-desktop-search-height: var(--mx-desktop-shell-header-height);

        border-start-start-radius: var(--cpd-space-3x);
        border: 1px solid var(--cpd-color-border-interactive-secondary);
        /* The resize separator next to the sidebar is its end border, so the two don't double up. */
        border-block-end: 0;
        border-inline-end: 0;
        background: var(--mx-desktop-shell-frame);
    }

    .mx_Separator {
        --cpd-color-bg-subtle-primary: var(--cpd-color-border-interactive-secondary);
    }

    .mx_RoomListPanel {
        --grouped-list-header-background: var(--mx-desktop-shell-frame);
        min-height: 0;
        padding-block-end: var(--mx-desktop-dock-clearance);
        background: var(--mx-desktop-shell-frame);

        /* Give server categories breathing room below the header without changing row or dock spacing. */
        > [data-testid="room-list-header"] + * {
            padding-block-start: var(--cpd-space-4x);
        }
    }

    .mx_RoomView_wrapper,
    .mx_RoomView {
        background: var(--cpd-color-bg-canvas-default);
    }

    .mx_RoomHeader {
        height: var(--mx-desktop-shell-header-height);
        min-height: var(--mx-desktop-shell-header-height);
        background: var(--cpd-color-bg-canvas-default);
        border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);

        .mx_RoomHeader_heading {
            font: var(--cpd-font-body-md-semibold);
        }

        .mx_RoomHeader_info:has(.mx_DesktopShell_channelTopic) {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .mx_DesktopShell_channelTopic {
            min-width: 0;
            padding-inline-start: 12px;
            border-inline-start: 1px solid var(--cpd-color-border-interactive-secondary);
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            font: var(--cpd-font-body-sm-regular);
            color: var(--cpd-color-text-secondary);
        }

        /* The name opens the channel menu (or a person's profile), the topic opens a dialog; neither is room info. */
        .mx_DesktopShell_channelInfo {
            display: flex;
            align-items: center;
            gap: 12px;
            min-width: calc(var(--cpd-space-16x) * 1.5);
        }

        /* The name keeps its width and the topic gives way first. */
        .mx_DesktopShell_channelName {
            display: flex;
            align-items: center;
            gap: 4px;
            flex: 0 0 auto;
            max-width: 100%;
            padding: 2px 6px;
            margin-inline-start: -6px;
            border: 0;
            border-radius: 4px;
            background: transparent;
            color: inherit;
            font: inherit;
            text-align: start;
            cursor: pointer;

            &:hover,
            &[aria-expanded="true"] {
                background: var(--cpd-color-bg-subtle-secondary);
            }

            &:focus-visible {
                outline: 2px solid var(--cpd-color-border-focused);
            }
        }

        .mx_DesktopShell_channelChevron {
            flex-shrink: 0;
            width: 16px;
            height: 16px;
            color: var(--cpd-color-icon-secondary);
        }

        .mx_DesktopShell_channelName .mx_RoomHeader_heading {
            min-width: 0;
            white-space: nowrap;
        }

        button.mx_DesktopShell_channelTopic {
            flex: 1 1 0;
            min-width: 0;
            border-block: 0;
            border-inline-end: 0;
            padding-block: 0;
            padding-inline-end: 0;
            background: transparent;
            text-align: start;
            cursor: pointer;

            &:hover {
                color: var(--cpd-color-text-primary);
            }

            &:focus-visible {
                outline: 2px solid var(--cpd-color-border-focused);
            }
        }

        .mx_BaseAvatar {
            width: 28px;
            height: 28px;
        }

        .mx_FacePile {
            padding: var(--cpd-space-1x);
            background: transparent;
        }
    }

    /* The search view owns its field border and spacing; override Element's legacy global text-input rules. */
    .mx_RoomHeader input[role="combobox"][aria-autocomplete="list"] {
        margin: 0;
        padding: 0;
        border: 0;
        font: var(--cpd-font-body-md-regular);
    }

    .mx_DesktopShell_channelSymbols {
        display: flex;
        flex-shrink: 0;
        align-items: center;
        gap: var(--cpd-space-2x);
    }

    .mx_DesktopShell_channelIcon {
        height: 24px;
        width: 24px;
        flex-shrink: 0;
        color: var(--cpd-color-icon-tertiary);
    }

    /* Same rounded square as the channel's icon in the room list. */
    .mx_DesktopShell_channelImage {
        flex-shrink: 0;

        &,
        img {
            border-radius: var(--cpd-space-1-5x);
        }
    }

    .mx_EventTile {
        /*
         * A faint tint of the text colour: this theme's subtle token is its darkest surface, which reads as a hole.
         * Mixed into the page colour rather than transparent, because the tile's layers overlap and would add up.
         */
        --event-tile-state-hover-background: color-mix(
            in srgb,
            var(--cpd-color-text-primary) 4%,
            var(--cpd-color-bg-canvas-default)
        );
        --event-tile-state-selected-background: color-mix(
            in srgb,
            var(--cpd-color-text-primary) 6%,
            var(--cpd-color-bg-canvas-default)
        );
        --EventTile_group_line-line-height: 22px;
    }

    /* Matches the 15px desktop message size in EventTileView. */
    .mx_EventTile_content {
        font-size: 15px;
        line-height: 22px;
    }

    /*
     * A collapsed run of room changes reads as one line of text with its toggle right after it, rather than the
     * toggle floating at the far edge of the timeline, away from what it opens.
     */
    .mx_GenericEventListSummary[data-layout="group"] {
        &[data-expanded="false"] {
            display: flex;
            align-items: center;

            > .mx_EventTile_line {
                flex: 0 1 auto;
                min-width: 0;
            }
        }

        .mx_GenericEventListSummary_toggle {
            order: 1;
            float: none;
            flex: none;
            margin-inline: var(--cpd-space-2x) 0;
            padding: 0;
            color: var(--cpd-color-text-action-accent);
            font: var(--cpd-font-body-sm-medium);
            text-decoration: none;

            &:hover,
            &:focus-visible {
                text-decoration: underline;
            }
        }

        &[data-expanded="true"] .mx_GenericEventListSummary_toggle {
            margin-inline-start: var(--cpd-space-16x);
        }
    }

    /*
     * In compact messages the text flows around the time and name, so its later lines return under the name. Text
     * bodies clip their overflow to trap stacked marks, and `hidden` would make each a box that sits beside the name
     * instead; `clip` traps the marks without that.
     */
    &.mx_MatrixChat_useCompactLayout .mx_EventTile_line :is(.mx_MTextBody, .mx_EventTile_body),
    .mx_MatrixChat_useCompactLayout .mx_EventTile_line :is(.mx_MTextBody, .mx_EventTile_body) {
        overflow: clip;
    }

    /*
     * The day between messages is a quiet label on a faint rule: small, semibold and muted, so it marks the change
     * of day without competing with the messages around it.
     */
    .mx_TimelineSeparator {
        margin-block: var(--cpd-space-4x) var(--cpd-space-1x);
        font: var(--cpd-font-body-xs-semibold);
        color: var(--cpd-color-text-secondary);

        > hr {
            border-bottom-color: var(--cpd-color-border-interactive-secondary);
        }

        /* The label between the two halves of the rule. */
        > :not(hr) {
            padding-inline: var(--cpd-space-2x);
        }
    }

    /*
     * Pictures sent together (see GalleryGrouper): the first is an ordinary message, and the rest fill a grid as wide
     * as a picture under it, cropped to squares when they share a row.
     */
    .mx_DesktopGallery {
        list-style: none;
        padding-block: var(--cpd-space-1x) var(--cpd-space-0-5x);
    }

    .mx_DesktopGallery_list {
        display: grid;
        grid-template-columns: repeat(var(--mx-desktop-gallery-columns, 1), minmax(0, 1fr));
        gap: var(--cpd-space-1x);
        /* The message text's column, and the width of a picture at the normal size. */
        width: min(324px, calc(100% - 64px - 96px));
        margin: 0 0 0 64px;
        padding: 0;
        list-style: none;

        > .mx_EventTile {
            min-width: 0;
            margin: 0;
            padding: 0;
            background: none;
            box-shadow: none;
        }

        .mx_EventTile_line {
            padding: 0;
            margin: 0;
        }

        /* Each picture is part of one message: no time or read receipts of its own in the grid. */
        [data-testid="event-tile-slot-timestamp"],
        [data-testid="event-tile-slot-receipt"] {
            display: none;
        }

        /* The frame's inline size comes from the picture's own dimensions; in the grid the cell decides. */
        .mx_ImageBody,
        .mx_ImageBody_container {
            width: 100% !important; /* Overrides the inline size from the media info */
            max-width: none !important; /* Overrides the inline size from the media info */
            max-height: none !important; /* Overrides the inline size from the media info */
        }

        .mx_ImageBody_container {
            border-radius: var(--cpd-space-2x);
            overflow: hidden;
        }

        &:not([data-columns="1"]) {
            .mx_ImageBody_container {
                aspect-ratio: 1 !important; /* Overrides the picture's own aspect ratio to crop it square */
            }

            .mx_ImageBody_image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }
    }

    /* Text sent with files reads first, above them, as a message that carries attachments. */
    .mx_EventTile_captioned {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-1x);

        > :last-child {
            order: -1;
        }
    }

    /*
     * Mentions read as accent text on a soft accent wash, filling with the accent on hover, as in Discord. The text
     * colour is the readable accent pulled towards the body text, so it stays legible on the wash in every theme.
     */
    .mx_Pill.mx_Pill_desktopMention,
    .mx_BasicMessageComposer .mx_BasicMessageComposer_input span:is(.mx_UserPill, .mx_RoomPill, .mx_SpacePill) {
        --mx-desktop-mention-text: color-mix(
            in srgb,
            var(--cpd-color-text-action-accent) 75%,
            var(--cpd-color-text-primary)
        );
        --mx-desktop-mention-background: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 28%, transparent);

        display: inline;
        padding: 0 2px;
        border-radius: 3px;
        line-height: inherit;
        vertical-align: baseline;
        font-weight: var(--cpd-font-weight-medium);
        color: var(--mx-desktop-mention-text) !important; /* To override .markdown-body */
        background-color: var(--mx-desktop-mention-background) !important; /* To override .markdown-body */
        transition:
            background-color 80ms ease-out,
            color 80ms ease-out;
    }

    a.mx_Pill.mx_Pill_desktopMention:is(:hover, :focus-visible) {
        color: var(--cpd-color-text-on-solid-primary) !important; /* To override .markdown-body */
        background-color: var(--cpd-color-bg-accent-rest) !important; /* To override .markdown-body */
    }

    /* @room and keywords aren't links, so they keep the wash on hover. */
    .mx_Pill.mx_Pill_desktopMention.mx_AtRoomPill:hover {
        color: var(--mx-desktop-mention-text) !important; /* To override .markdown-body */
        background-color: var(--mx-desktop-mention-background) !important; /* To override .markdown-body */
    }

    /* In the composer the avatar slot carries the mention's sigil instead. */
    .mx_BasicMessageComposer .mx_BasicMessageComposer_input span.mx_UserPill::before {
        all: unset;
        content: "@";
    }

    .mx_BasicMessageComposer .mx_BasicMessageComposer_input span:is(.mx_RoomPill, .mx_SpacePill)::before {
        all: unset;
        content: "#";
    }

    .mx_BasicMessageComposer .mx_BasicMessageComposer_input span:is(.mx_UserPill, .mx_RoomPill, .mx_SpacePill):hover {
        background-color: var(--mx-desktop-mention-background) !important; /* To override the base composer rule */
    }

    /*
     * Attachments in the timeline become Aether media cards: a soft accent wash, a rounded tile for the
     * file icon and an accent play button and progress. Composer previews keep Element's style.
     */
    .mx_EventTile .mx_MediaBody {
        max-width: 400px;
        padding: 10px 12px;
        border-radius: 12px;
        background: linear-gradient(
            135deg,
            color-mix(in srgb, var(--cpd-color-bg-accent-rest) 12%, var(--cpd-color-bg-subtle-primary)),
            var(--cpd-color-bg-subtle-primary) 65%
        );
        transition: border-color 120ms ease-out;

        &:hover {
            border-color: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 45%, transparent);
        }
    }

    .mx_EventTile .mx_MFileBody [data-type="info"] > button {
        align-items: center;

        > svg {
            width: 20px;
            height: 20px;
            padding: 10px;
            border-radius: 10px;
            color: var(--cpd-color-icon-accent-primary);
            background: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 18%, transparent);
        }

        > span {
            font: var(--cpd-font-body-md-medium);
        }
    }

    .mx_EventTile :is(.mx_MAudioBody, .mx_MVoiceMessageBody) .mx_MediaBody {
        /*
         * The seek bar and the unplayed waveform paint with these Compound greys. The border colour they used to
         * take is a faint tint in most themes, so the waveform all but vanished; the muted text colour stays
         * readable on every surface. Played bars take the accent colour meant for text, which keeps its contrast
         * where the accent fill would not.
         */
        --cpd-color-gray-600: color-mix(in srgb, var(--cpd-color-text-secondary) 55%, transparent);
        --cpd-color-gray-800: var(--cpd-color-text-action-accent);

        border: 1px solid var(--cpd-color-border-interactive-secondary);
        color: var(--cpd-color-text-primary);

        .mx_Clock {
            color: var(--cpd-color-text-secondary);
            font: var(--cpd-font-body-sm-medium);
            font-variant-numeric: tabular-nums;
        }

        button[aria-label] {
            /* Compound's icon button colours its icon from these. */
            --cpd-color-icon-primary: var(--cpd-color-icon-on-solid-primary);
            --cpd-color-icon-secondary: var(--cpd-color-icon-on-solid-primary);
            --cpd-color-icon-tertiary: var(--cpd-color-icon-on-solid-primary);

            background: var(--cpd-color-bg-accent-rest);

            &:hover:not([disabled]) {
                background: var(--cpd-color-bg-accent-hovered);
            }
        }

        input[type="range"] {
            height: 4px;
            border-radius: 2px;

            &::before {
                height: 4px;
                border-radius: 2px;
            }

            &::-webkit-slider-thumb {
                width: 12px;
                height: 12px;
            }
        }

        .mx_Waveform .mx_Waveform_bar {
            background-color: var(--cpd-color-gray-600);

            &.mx_Waveform_bar_100pct {
                background-color: var(--cpd-color-gray-800);
            }
        }
    }

    .mx_NewRoomIntro {
        margin: 32px 16px 32px 16px;

        > h2 {
            margin-block: 16px 8px;
            font: var(--cpd-font-heading-lg-semibold);
        }

        .mx_NewRoomIntro_buttons {
            margin-block-start: 16px;
        }
    }

    .mx_NewRoomIntro.mx_DesktopShell_serverIntro {
        margin: 64px 24px 24px;
        text-align: center;

        > h2 {
            max-width: 520px;
            margin: 0 auto 8px;
            font: var(--cpd-font-heading-lg-regular);
            font-size: 32px;
            line-height: 40px;

            strong {
                display: block;
                font-weight: inherit;
            }
        }

        > p {
            margin: 8px 0 0;
            color: var(--cpd-color-text-primary);
        }
    }

    .mx_DesktopShell_introChannel {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: var(--cpd-color-bg-subtle-primary);
        display: grid;
        place-items: center;

        svg {
            width: 44px;
            height: 44px;
            color: var(--cpd-color-icon-primary);
        }
    }

    .mx_MessageComposer {
        /* The room view's 100% width plus these margins pushed the composer past the window's edge. */
        width: auto;
        /* Level with the account dock: the same 8px from the window's bottom, and the same height below. */
        margin: 0 16px 8px;
        padding-block-end: 0;

        .mx_MessageComposer_wrapper {
            border: 1px solid var(--cpd-color-border-interactive-secondary);
            border-radius: 8px;
            background: var(--cpd-color-bg-subtle-primary);
            padding-inline: 12px;
            margin: 0;
        }

        .mx_MessageComposer_row {
            min-height: var(--mx-desktop-dock-row-height);
        }

        .mx_MessageComposer_input,
        .mx_SendMessageComposer .mx_BasicMessageComposer {
            min-height: calc(var(--mx-desktop-dock-row-height) - 2px);
            font-size: 15px;
        }

        /* The themed red and ring, which stay readable on any composer colour. */
        .mx_VoiceRecordComposerTile_stop {
            border-color: var(--cpd-color-gray-600);

            svg {
                color: var(--cpd-color-icon-critical-primary);
            }
        }

        .mx_MessageComposer_actions {
            gap: 16px;
            align-self: center;
        }

        .mx_DesktopShell_attachment {
            /* First in the row, ahead of the encryption icon that precedes it in the markup. */
            order: -1;
            width: 32px;
            height: 32px;
            padding: 4px;
            flex: none;
            margin-inline-end: 12px;
        }

        /*
         * The room's encryption state sits in the row, between the attachment button and the text, centred on the
         * row instead of floating over the button's corner.
         */
        .mx_MessageComposer_e2eIconWrapper {
            position: static;
            flex: none;
            display: flex;
            align-items: center;
            align-self: center;
            width: 16px;
            height: 16px;
            margin: 0 8px 0 -4px;
        }

        .mx_MessageComposer_input textarea {
            background: transparent;
        }

        /*
         * A change to someone's identity heads the composer box as a strip across its top: tinted, with the text in
         * the body colour so it stays readable, and a compact action at its end.
         */
        .mx_UserIdentityWarning {
            --mx-desktop-identity-tint: var(--cpd-color-icon-warning-primary, var(--cpd-color-yellow-900));

            margin: 0 -12px;
            padding: 8px 12px;
            border-block-end: 1px solid var(--cpd-color-border-interactive-secondary);
            border-start-start-radius: 8px;
            border-start-end-radius: 8px;
            background: color-mix(in srgb, var(--mx-desktop-identity-tint) 10%, transparent);

            &.critical {
                --mx-desktop-identity-tint: var(--cpd-color-icon-critical-primary);
            }

            /* The strip's own edge replaces the separator above it. */
            > :not(.mx_UserIdentityWarning_row) {
                display: none;
            }

            .mx_UserIdentityWarning_row {
                gap: 12px;

                .mx_BaseAvatar {
                    --cpd-avatar-size: 24px;

                    flex: none;
                    margin: 0;
                }

                .mx_UserIdentityWarning_main {
                    margin: 0;
                    font: var(--cpd-font-body-sm-regular);
                    color: var(--cpd-color-text-primary);

                    &.critical {
                        color: var(--cpd-color-text-critical-primary);
                    }
                }

                > button {
                    flex: none;
                    min-height: 32px;
                    padding-block: 4px;
                    padding-inline: 12px;
                    font: var(--cpd-font-body-sm-semibold);
                }
            }
        }
    }

    /*
     * The member list starts below the header row, which carries the window controls above it when the system
     * title bar is replaced (see the header row rules above). The header's bottom border is carried across and
     * sits out of view without the controls.
     */
    .mx_RightPanel {
        padding-block-start: var(--mx-window-controls-block-size);
        background-color: var(--mx-desktop-shell-frame);
        background-image: linear-gradient(
            var(--cpd-color-border-interactive-secondary),
            var(--cpd-color-border-interactive-secondary)
        );
        background-position: 0 env(titlebar-area-height, -1px);
        background-size: 100% 1px;
        background-repeat: no-repeat;
        border-inline-start: 1px solid var(--cpd-color-border-interactive-secondary);
        -webkit-app-region: drag;

        > * {
            -webkit-app-region: no-drag;
        }
    }

    /* A shared room header already keeps every content column below the native controls. */
    .mx_RoomView:has(> .mx_RoomHeader) .mx_RightPanel {
        padding-block-start: 0;
        background-image: none;
    }

    .mx_RightPanel:has(.mx_ThreadView) {
        width: 100%;
        background-color: var(--cpd-color-bg-canvas-default);
    }

    .mx_ThreadView .mx_BaseCard_header {
        min-height: 48px;
        padding: 8px 12px;
        border-block-end: 1px solid var(--cpd-color-border-interactive-secondary);
    }

    .mx_ThreadView .mx_BaseCard_header .mx_DesktopThreadView_title {
        height: auto;
        gap: 12px;
        min-width: 0;

        > svg {
            flex: none;
            width: 24px;
            height: 24px;
            color: var(--cpd-color-icon-secondary);
        }

        > div {
            flex: 1;
            min-width: 0;
        }

        h2 {
            margin: 0;
            font: var(--cpd-font-body-md-semibold);
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }

        p {
            margin: 0;
            color: var(--cpd-color-text-secondary);
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
        }
    }

    @media (width < 800px) {
        .mx_MainSplit:has(.mx_ThreadView) {
            position: relative;

            /* Keep the channel's raised status area below the thread overlay. */
            > .mx_RoomView_body {
                isolation: isolate;
            }
        }

        .mx_RightPanel_ResizeWrapper:has(.mx_ThreadView) {
            position: absolute !important;
            inset-block: 0;
            inset-inline-end: 0;
            width: min(100%, 420px) !important;
            max-width: 100% !important;
            min-width: 0 !important;
            z-index: 10;
        }
    }

    .mx_RightPanel:has(.mx_MemberListView) {
        background-color: var(--cpd-color-bg-canvas-default);
    }

    .mx_MemberListView {
        padding-inline: 12px;

        .mx_MemberTileView {
            /* DESKTOP_MEMBER_LIST_ITEM_HEIGHT in MemberListView, shared with the presence headings. */
            height: 48px;
            padding: 6px 10px;
            border: 0;
            border-radius: 8px;

            &:hover,
            &:focus-visible {
                background: var(--cpd-color-bg-action-tertiary-hovered);
                /* A list of decorated people stays still until the pointer or keyboard reaches one of them. */
                --profile-motion: running;
            }

            .mx_MemberTileView_left,
            .mx_MemberTileView_right {
                position: relative;
                z-index: 1;
            }

            .mx_MemberTileView_name {
                font: var(--cpd-font-body-lg-medium);
            }

            .mx_MemberTileView_status {
                overflow: hidden;
                color: var(--cpd-color-text-secondary);
                font: var(--cpd-font-body-xs-regular);
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .mx_MemberTileView_userLabel {
                margin-inline-start: 4px;
                font-size: 10px;
            }

            /* Discord's status dot: a ring in the row's colour separates it from the avatar, like a cutout. */
            .mx_MemberTileView_presence {
                inset-inline-end: -3px;
                inset-block-end: -3px;
            }

            .mx_PresenceIconView {
                /* Larger than a plain dot needs: the crescent has to read as a moon at this size. */
                padding: 2px;
                background: var(--cpd-color-bg-canvas-default);

                svg {
                    width: 12px;
                    height: 12px;
                }

                .mx_PresenceIconView_online {
                    color: var(--cpd-color-icon-success-primary);
                }

                .mx_PresenceIconView_unavailable {
                    color: var(--cpd-color-icon-warning-primary);
                }

                .mx_PresenceIconView_dnd {
                    color: var(--cpd-color-icon-critical-primary);
                }
            }

            &:is(:hover, :focus-visible) .mx_PresenceIconView {
                background:
                    linear-gradient(
                        var(--cpd-color-bg-action-tertiary-hovered),
                        var(--cpd-color-bg-action-tertiary-hovered)
                    ),
                    var(--cpd-color-bg-canvas-default);
            }
        }
    }

    .mx_DesktopShell_memberHeading {
        margin: 0;
        padding: 20px 10px 6px;
        height: 48px;
        box-sizing: border-box;
        font: var(--cpd-font-body-sm-medium);
        color: var(--cpd-color-text-tertiary, var(--cpd-color-text-secondary));
    }

    .mx_EntityTile {
        border-radius: 6px;
    }

    .mx_RoomView_statusArea {
        min-height: 24px;
    }
}

@media (max-width: 720px) {
    body.mx_DesktopShell .mx_TabbedView_tabsOnLeft.mx_TabbedView_responsive {
        .mx_TabbedView_tabLabels {
            width: 44px;
        }

        .mx_TabbedView_tabLabel_text {
            display: none;
        }

        .mx_TabbedView_tabPanel {
            margin-inline-start: 60px;
        }
    }
}

/*
 * Aether's loading spinner: a body orbiting a faint ring. It also appears before sign-in, where the
 * Aether colour roles are not defined yet, so it falls back to the Polar primitive.
 */
.mx_DesktopShell_spinner {
    --mx-desktop-spinner-colour: var(--ae-accent, #8ed8ea);

    position: relative;
    display: inline-block;
    flex: none;
    animation: mx_DesktopShell_orbit 1.1s linear infinite;

    &::after {
        content: "";
        position: absolute;
        inset: 12.5%;
        border: 2px solid color-mix(in srgb, var(--mx-desktop-spinner-colour) 24%, transparent);
        border-radius: 50%;
    }

    /* Centred on the ring's top edge. */
    &::before {
        content: "";
        position: absolute;
        top: 0;
        left: 37.5%;
        width: 25%;
        height: 25%;
        border-radius: 50%;
        background: var(--mx-desktop-spinner-colour);
        box-shadow: 0 0 6px var(--mx-desktop-spinner-colour);
    }
}

@keyframes mx_DesktopShell_orbit {
    to {
        transform: rotate(1turn);
    }
}

@media (prefers-reduced-motion: reduce) {
    /* Loading still needs a visible cue, so the orbit slows rather than stops. */
    .mx_DesktopShell_spinner {
        animation-duration: 4s;
    }
}

.mx_DesktopShell_accountDock {
    position: absolute;
    inset-inline-start: 8px;
    inset-block-end: 8px;
    z-index: 20;
    max-width: calc(100% - 16px);
}

/* Conversations keep their live timeline and composer below the persistent call surface. */
body.mx_DesktopShell .mx_RoomView_conversationCallStage {
    flex: 0 0 auto;
    min-height: 0;
    padding-bottom: 8px;
    box-sizing: border-box;
}

body.mx_DesktopShell .mx_RoomView_callResizeHandle {
    background: var(--cpd-color-bg-canvas-default);

    > [role="separator"] {
        width: 100%;
        height: 100%;
        cursor: row-resize;
        touch-action: none;
        outline-offset: -2px;
    }

    &:hover,
    &:focus-within {
        box-shadow: inset 0 -2px 0 var(--cpd-color-border-focused);
    }
}

body.mx_DesktopShell .mx_RoomView_conversationCallStage .mx_CallView {
    width: 100%;
    height: 100%;
}

body.mx_DesktopShell.cpd-theme-dark,
body.mx_DesktopShell.cpd-theme-dark-hc {
    --aether-call-background: #000000;
}
