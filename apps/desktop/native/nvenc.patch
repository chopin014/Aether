+/// Use the four-byte Annex-B delimiters reconstructed by WebRTC's RTP depacketizer.
+/// AES-GCM authenticates the clear NAL header, so delimiter normalization must happen before encryption.
+pub fn normalize_annex_b(data: &[u8]) -> Vec<u8> {
+    let mut out = Vec::with_capacity(data.len() + 8);
+    let mut index = 0;
+    while index < data.len() {
+        if data[index..].starts_with(&[0, 0, 0, 1]) {
+            out.extend_from_slice(&[0, 0, 0, 1]); index += 4;
+        } else if data[index..].starts_with(&[0, 0, 1]) {
+            out.extend_from_slice(&[0, 0, 0, 1]); index += 3;
+        } else { out.push(data[index]); index += 1; }
+    }
+    out
+}
