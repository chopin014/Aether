+/// Smallest relative bitrate change, in percent, that is worth an NVENC reconfigure.
+pub const RATE_CHANGE_THRESHOLD_PERCENT: u32 = 10;
+
+/// Apply WebRTC's target bitrate while keeping the configured frame rate.
+///
+/// Every reconfigure resets part of NVENC's rate control, so small estimator changes and changes arriving before
+/// `allow_bitrate_change` permits another one keep the previous bitrate.
+pub fn update_rate_control(mut next: EncoderConfig, previous: EncoderConfig, bitrate: Option<u32>,
+    allow_bitrate_change: bool) -> EncoderConfig {
+    next.bitrate_bps = previous.bitrate_bps;
+    next.fps_num = previous.fps_num;
+    next.fps_den = previous.fps_den;
+    if let Some(bitrate) = bitrate.filter(|value| *value > 0) {
+        let threshold = (previous.bitrate_bps / 100 * RATE_CHANGE_THRESHOLD_PERCENT).max(1);
+        if allow_bitrate_change && bitrate.abs_diff(previous.bitrate_bps) >= threshold {
+            next.bitrate_bps = bitrate;
+        }
+    }
+    next
+}
+
+/// Choose the frame rate NVENC budgets bits for.
+///
+/// The first picture carries the stream's frame rate. Afterwards WebRTC reports a per-frame estimate that swings
+/// widely, so only a clear increase is followed; this covers a layer that started while the estimate was still low
+/// without reconfiguring NVENC for every dip.
+pub fn update_frame_rate(previous: (u32, u32), reported: Option<(u32, u32)>, started: bool,
+    allow_change: bool) -> (u32, u32) {
+    let Some((num, den)) = reported.filter(|(num, den)| *num > 0 && *den > 0) else { return previous };
+    if !started {
+        return (num, den);
+    }
+    // Compare num/den > 1.1 * previous_num/previous_den without floating point.
+    let increased = u64::from(num) * u64::from(previous.1) * 10 > u64::from(previous.0) * u64::from(den) * 11;
+    if allow_change && increased { (num, den) } else { previous }
+}
