+const positive = (value) => typeof value === "number" && Number.isFinite(value) && value > 0;
+
+/** Validate a complete preference after merging a partial update, then cap it to deployment policy. */
+export function aetherResolveScreenShareQuality(policy, raw = {}) {
+    const maxHeight = positive(policy?.max_resolution) ? policy.max_resolution : 1080;
+    const maxFps = positive(policy?.max_framerate) ? Math.min(policy.max_framerate, 60) : 30;
+    const maxBr = positive(policy?.max_bitrate) ? policy.max_bitrate : 5000000;
+    return {
+        resolutionHeight: Math.min(positive(raw.resolutionHeight) ? raw.resolutionHeight : maxHeight, maxHeight),
+        frameRate: Math.min(positive(raw.frameRate) ? raw.frameRate : 30, maxFps),
+        maxBitrate: Math.min(positive(raw.maxBitrate) ? raw.maxBitrate : maxBr, maxBr),
+        includeSystemAudio: typeof raw.includeSystemAudio === "boolean" ? raw.includeSystemAudio : false,
+    };
+}
+
+/** Bound capture before publishing; ideal constraints alone can exceed a deployment maximum. */
+export async function aetherConstrainScreenTrack(track, quality) {
+    await track.mediaStreamTrack.applyConstraints({
+        width: {
+            ideal: Math.round((quality.resolutionHeight * 16) / 9),
+            max: Math.round((quality.resolutionHeight * 16) / 9),
+        },
+        height: { ideal: quality.resolutionHeight, max: quality.resolutionHeight },
+        frameRate: { ideal: quality.frameRate, max: quality.frameRate },
+    });
+}
+
+const senderLayerLimits = new WeakMap();
+
+/** Whether capture really published a live, unmuted stream audio track, regardless of the requested preference. */
+export function aetherHasLiveScreenShareAudio(reference) {
+    const publication = reference?.publication;
+    return !!publication?.track && !publication.isMuted && publication.track.mediaStreamTrack.readyState === "live";
+}
+
+/** Bound every layer and backup codec while allowing the primary layer to increase after a previous reduction. */
+export async function aetherConstrainScreenSenders(track, quality) {
+    const senders = new Set([
+        track.sender,
+        ...Array.from(track.simulcastCodecs?.values() ?? [], (codec) => codec.sender),
+    ]);
