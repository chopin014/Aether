+                        simulcast: false,
+                        backupCodec: false,
+                    });
+                }
+                if (disposed || !requested || ticket !== generation) return release();
+                await aetherConstrainScreenSenders(video, next);
+                if (disposed || !requested || ticket !== generation) return release();
+                current = next;
+                commit(next);
+            } catch (error) {
+                requested = false;
+                for (const track of tracks) track.stop();
+                await release();
+                throw error;
+            }
+        });
+    };
+    return {
+        setEnabled,
+        update,
+        get requested() {
+            return requested;
+        },
+        dispose: () => {
+            disposed = true;
+            requested = false;
+            ++generation;
+            // Stop acquired tracks immediately, even while a publisher operation is pending.
+            for (const track of owned) track.stop();
+            return enqueue(release);
+        },
+    };
+}
