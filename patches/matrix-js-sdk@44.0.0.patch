+function fetchRelationParent(client: MatrixClient, roomId: string, eventId: string): Promise<Partial<IEvent>> {
+    let slots = relationParentFetches.get(client);
+    if (!slots) relationParentFetches.set(client, (slots = { active: 0, waiting: [] }));
+    const run = async (): Promise<Partial<IEvent>> => {
