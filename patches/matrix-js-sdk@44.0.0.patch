+// Missing relation parents are fetched ahead of ingestion, so bound how many run at once across all rooms of a
+// client. Waiters are served in order, so the earliest events of each batch get their parents first.
+const RELATION_PARENT_FETCH_LIMIT = 6;
+const relationParentFetches = new WeakMap<MatrixClient, { active: number; waiting: Array<() => void> }>();
+
+function fetchRelationParent(client: MatrixClient, roomId: string, eventId: string): Promise<Partial<IEvent>> {
+    let slots = relationParentFetches.get(client);
+    if (!slots) relationParentFetches.set(client, (slots = { active: 0, waiting: [] }));
+    const run = async (): Promise<Partial<IEvent>> => {
+        slots.active++;
+        try {
+            return await client.fetchRoomEvent(roomId, eventId);
+        } finally {
+            slots.active--;
+            slots.waiting.shift()?.();
+        }
+    };
+    if (slots.active < RELATION_PARENT_FETCH_LIMIT) return run();
+    return new Promise<void>((resolve) => slots.waiting.push(resolve)).then(run);
+}
