+function applyGlobalAccountData(client: MatrixClient, globalAccountData: IMinimalEvent[]): void {
+    const events = mapEvents(client, undefined, globalAccountData);
+    const prevEventsMap = events.reduce<Record<string, MatrixEvent | undefined>>((m, c) => {
+        m[c.getType()] = client.store.getAccountData(c.getType());
