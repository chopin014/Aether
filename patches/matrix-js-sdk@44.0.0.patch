+
+/**
+ * Aether: the call's fast lane.
+ *
+ * Joining a call needs the members to exchange media keys, and their keys only travel as Olm-encrypted to-device
+ * messages through the homeserver: a write, then the receiver's sync. With the joiner's membership crossing sync
+ * first, hearing each other takes three such trips after the media itself is already flowing.
+ *
+ * The call's media room (LiveKit) is already connected to everyone by then. A "carrier" sends the very same kind of
+ * Olm-encrypted to-device message to a device through that room's data channel ("sealed" messages): the media server
+ * relays ciphertext it cannot read, exactly as the homeserver does, and the receiver decrypts it with its Olm
+ * machine as if it had come through sync, which authenticates the sending device. Everything that goes through the
+ * carrier also goes through the homeserver, as separate Olm messages, so a peer without the fast lane, or a lost
+ * packet, only means the usual timing.
+ *
+ * A joiner also sends a sealed "hello" carrying the call membership it is writing to the room: the members show it
+ * and exchange keys with it at once ("provisional" membership) instead of waiting for the state event to reach them,
+ * for a few seconds until that event arrives.
+ */
+
+import type { MatrixClient } from "../client.ts";
+import type { CallMembership } from "./CallMembership.ts";
+
+/** The LiveKit data topic of sealed messages. They skip LiveKit's own data encryption: they are Olm ciphertext. */
+export const SEALED_TOPIC = "io.aether.sealed";
+
+/** The to-device event type of a joiner's hello. Its content is {@link HelloContent}. */
+export const HELLO_EVENT_TYPE = "io.aether.call.hello";
+
+/** How long a membership known only from a hello counts, waiting for its state event. */
+export const PROVISIONAL_MEMBERSHIP_MS = 8_000;
+
+/** A hello older than this, by the sender's clock, is ignored. */
+export const HELLO_MAX_AGE_MS = 30_000;
+
+/** A device's hellos are taken at most once per this period. */
+export const HELLO_MIN_INTERVAL_MS = 2_000;
+
+/** The content of a {@link HELLO_EVENT_TYPE} to-device event. */
+export interface HelloContent {
+    /** The room of the call joined. */
+    room_id: string;
+    /** The call membership content the joiner is writing as its state event. */
+    membership: Record<string, unknown>;
+    /** When it was sent, by the sender's clock. */
+    ts: number;
+}
+
+/** A to-device message as it travels: already Olm encrypted. */
+export interface SealedMessage {
+    type: string;
+    content: Record<string, unknown>;
+}
+
+/**
+ * Sends sealed messages to the devices in a call's media room. Provided by the media layer (Element Call) once its
+ * LiveKit room is connected, through {@link MatrixRTCSession.aetherSetCarrier}.
+ */
+export interface CallCarrier {
+    /** Whether the device is in the call's media room, so that it can be sent sealed messages. */
+    canReach(userId: string, deviceId: string): boolean;
+    /** Sends an Olm-encrypted to-device message to a device in the media room. Delivery is best effort. */
+    send(userId: string, deviceId: string, message: SealedMessage): void;
+}
+
+/**
+ * Olm-encrypts a to-device message for each device and sends it through the carrier. These are messages of their
+ * own, never a copy of what goes through the homeserver: replaying an Olm message would look like a broken session.
+ *
+ * @returns the devices it was sent to.
+ */
+export async function sendSealed(
+    client: Pick<MatrixClient, "getCrypto">,
+    carrier: CallCarrier,
+    eventType: string,
+    devices: { userId: string; deviceId: string }[],
+    content: Record<string, unknown>,
+): Promise<{ userId: string; deviceId: string }[]> {
+    const crypto = client.getCrypto();
+    const reachable = devices.filter(({ userId, deviceId }) => carrier.canReach(userId, deviceId));
+    if (!crypto || reachable.length === 0) return [];
+    const batch = await crypto.encryptToDeviceMessages(eventType, reachable, content);
+    const sent: { userId: string; deviceId: string }[] = [];
+    for (const { userId, deviceId, payload } of batch.batch) {
+        // The carrier may have lost the device while we encrypted.
+        if (!carrier.canReach(userId, deviceId)) continue;
+        carrier.send(userId, deviceId, { type: batch.eventType, content: payload as Record<string, unknown> });
+        sent.push({ userId, deviceId });
+    }
+    return sent;
+}
+
+/**
+ * Whether two memberships are the same participation, for deciding who joined or left. A membership known from a
+ * hello and its state event differ in their timestamp (the state event's is the homeserver's), but carry the same
+ * join id, which Aether's membership manager makes for each join.
+ */
+export function participationOf(membership: CallMembership): number {
+    const joinId = membership.aetherJoinId;
+    if (joinId === undefined) return membership.createdTs();
+    // FNV-1a: only ever compared between participations of the same device.
+    let hash = 0x811c9dc5;
+    for (let i = 0; i < joinId.length; i++) {
+        hash ^= joinId.charCodeAt(i);
+        hash = Math.imul(hash, 0x01000193) >>> 0;
+    }
+    return hash;
+}
